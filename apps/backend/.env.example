# Copiar a .env y ajustar si hace falta.
# El .env NO se commitea (está en .gitignore); este .env.example sí.
# ConfigModule (src/config/env.validation.ts) valida estas variables al
# arrancar: si falta una obligatoria o está mal escrita, el bootstrap
# aborta con un mensaje claro.

# Conexión a PostgreSQL. Obligatoria.
# Los valores por defecto coinciden con compose.yml (raíz del repo):
# Postgres 16 en el puerto 5433 del host -> 5432 del contenedor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/qualitytrack?schema=public"

# Puerto HTTP de la API. Opcional (default: 3000).
PORT=3000

# --- Object storage (S3-compatible) — ver ADR-0010 --------------------
# Los valores por defecto apuntan al MinIO de compose.yml (raíz del repo):
# API S3 en localhost:9100, consola web en localhost:9101.
# En producción (Railway) estas variables se mapean al Storage Bucket con
# referencias ${{Bucket.*}} — NO se copian estos valores de dev.
STORAGE_ENDPOINT="http://localhost:9100"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="qualitytrack"
STORAGE_ACCESS_KEY_ID="minio"
STORAGE_SECRET_ACCESS_KEY="minio12345"
# MinIO necesita path-style (bucket en la ruta, no en el subdominio).
# Railway Buckets funciona con virtual-hosted style -> false o sin definir.
STORAGE_FORCE_PATH_STYLE=true
